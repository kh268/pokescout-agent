TAVILY_API_KEY=

# Gemini is the default LLM for the ReAct agent.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=google

# Optional alternative: set LLM_PROVIDER=openai to use these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: an OpenAI-compatible provider's API base URL.
# Set OPENAI_MODEL and OPENAI_API_KEY to that provider's values too.
# OPENAI_BASE_URL=

# Used only by the new research_agent.py when the primary key hits quota.
GOOGLE_API_KEY_FALLBACK=
# start_research.ps1 configures registration and the Docker callback automatically.
AGENTFIELD_SERVER=http://localhost:18080
